# Garmin Connect Credentials
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Athlete FTP (Functional Threshold Power) in Watts
# Used to calculate Normalized Power (NP), Intensity Factor (IF), and Training Stress Score (TSS)
ATHLETE_FTP=150

# Multi-User Filter (Optional)
# If set, workouts will only be uploaded if the FIT athlete profile name matches this value.
# Leave blank to upload all workouts regardless of profile name.
MYWHOOSH_PROFILE_NAME=

# Path Overrides (Optional)
# If left blank, the script automatically searches %LOCALAPPDATA%\MyWhoosh\Saved\Workouts
# and standard Microsoft Store package locations.
MYWHOOSH_WORKOUTS_DIR=

# Custom Archive Directory (Optional)
# If left blank, defaults to an 'Archive' subfolder inside the detected workouts directory.
ARCHIVE_DIR=

# --- Garmin Activity Metadata Enrichment ---
# Set to true to automatically update Garmin activity title with the workout name
# and description notes with Coggan metrics (NP, IF, TSS, Work)
UPDATE_GARMIN_METADATA=true
# Set to true to append the MyWhooshInfo.com workout link to the Garmin activity description
APPEND_MYWHOOSHINFO_URL=true

# --- GitHub Repository Backup & Indexing ---
# Set to true to enable automated ride FIT backup and CSV/JSON catalog indexing
ENABLE_GIT_BACKUP=true
# Target Git repository path where rides should be archived and cataloged
GIT_BACKUP_REPO_PATH="C:/Users/Andrew/Documents/github/York210-Controller"
# Subdirectory within the Git repository:
# - "auto" (default): automatically categorizes activities into 'cycling' and 'rowing' subfolders
# - "rides" / "activities": uses a fixed folder name
# - "": stores files directly at the repository root (e.g., {repo}/2026/10/file.fit)
GIT_BACKUP_SUBDIR="auto"
# Set to true to automatically 'git push' backup commits to the remote repository
GIT_AUTO_PUSH=true


